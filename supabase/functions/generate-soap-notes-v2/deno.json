{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0",
    "@supabase/functions-js": "jsr:@supabase/functions-js@^2.0.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.45.0",
    "zod": "npm:zod@4.1.11"
  },
  "tasks": {
    "test": "deno test --allow-net --allow-env --allow-read tests/",
    "test:unit": "deno test --allow-net --allow-env --allow-read tests/unit/",
    "test:integration": "deno test --allow-net --allow-env --allow-read tests/integration/",
    "test:supabase": "deno test --allow-net --allow-env --allow-read tests/supabase-edge-function.test.ts",
    "test:services": "deno test --allow-net --allow-env --allow-read tests/unit/*service.test.ts",
    "test:middleware": "deno test --allow-net --allow-env --allow-read tests/unit/*middleware.test.ts",
    "test:coverage": "deno test --allow-net --allow-env --allow-read --coverage=coverage tests/",
    "test:watch": "deno test --allow-net --allow-env --allow-read --watch tests/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
